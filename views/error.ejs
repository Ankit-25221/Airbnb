<% layout("/layouts/boilerplate") %>

<div class="wl-show-container text-center" style="padding: 5rem 1rem;">
    <div style="max-width: 480px; margin: 0 auto;">
        <!-- Error icon -->
        <div style="
            width: 80px; height: 80px; 
            background: linear-gradient(135deg, rgba(255,56,92,0.1), rgba(255,56,92,0.05));
            border-radius: 50%; 
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.5rem;
            border: 2px solid rgba(255,56,92,0.2);
        ">
            <i class="fa-solid fa-triangle-exclamation" style="font-size: 2rem; color: var(--wl-primary);"></i>
        </div>

        <h1 style="font-size: 1.75rem; font-weight: 700; color: var(--wl-black); margin-bottom: 0.75rem;">
            Something went wrong
        </h1>
        
        <p style="font-size: 1rem; color: var(--wl-gray); line-height: 1.6; margin-bottom: 2rem;">
            <%= message %>
        </p>

        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/listings" class="btn-wl-primary text-decoration-none px-4 py-2">
                <i class="fa-solid fa-house" style="margin-right: 0.4rem;"></i>Go Home
            </a>
            <button onclick="history.back()" class="btn-wl-outline px-4 py-2">
                <i class="fa-solid fa-arrow-left" style="margin-right: 0.4rem;"></i>Go Back
            </button>
        </div>
    </div>
</div>