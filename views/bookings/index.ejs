<% layout("/layouts/boilerplate") %>

<div class="wl-show-container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="wl-form-title mb-1">My Bookings</h2>
      <p class="wl-form-subtitle mb-0">Track and manage your upcoming and past trips</p>
    </div>
    <a href="/listings" class="btn-wl-outline text-decoration-none">
      <i class="fa-solid fa-arrow-left" style="margin-right: 0.4rem;"></i>Explore Stays
    </a>
  </div>

  <% if (bookings.length === 0) { %>
    <div class="wl-no-results text-center py-5" style="background: var(--wl-white); border-radius: var(--wl-radius-lg); border: 1px solid var(--wl-border-light);">
      <i class="fa-regular fa-calendar-check" style="font-size: 3.5rem; color: var(--wl-border); margin-bottom: 1rem; display: block;"></i>
      <h4 style="font-weight: 600; color: var(--wl-black);">No bookings yet</h4>
      <p style="color: var(--wl-gray); margin-bottom: 1.5rem;">Ready to start your next adventure? Find the perfect stay now.</p>
      <a href="/listings" class="btn-wl-primary px-4 py-2 text-decoration-none">Search Destinations</a>
    </div>
  <% } else { %>
    <div class="row">
      <% for (let booking of bookings) { %>
        <div class="col-lg-6 mb-4">
          <div class="wl-booking-item-card d-flex flex-column flex-sm-row gap-3 p-3" style="background: var(--wl-white); border-radius: var(--wl-radius-lg); border: 1px solid var(--wl-border-light); box-shadow: var(--wl-shadow-sm); position: relative; overflow: hidden; transition: all var(--wl-transition);">
            
            <!-- Left: Listing Image -->
            <div class="wl-booking-img-wrap" style="width: 100%; max-width: 160px; height: 120px; border-radius: var(--wl-radius); overflow: hidden; flex-shrink: 0;">
              <img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>" style="width: 100%; height: 100%; object-fit: cover;">
            </div>

            <!-- Right: Details -->
            <div class="d-flex flex-column justify-content-between flex-grow-1">
              <div>
                <div class="d-flex justify-content-between align-items-start gap-2">
                  <h5 class="mb-1" style="font-weight: 600; font-size: 1.1rem; line-height: 1.3;">
                    <a href="/listings/<%= booking.listing._id %>" style="color: var(--wl-black); text-decoration: none;"><%= booking.listing.title %></a>
                  </h5>
                  
                  <!-- Status badge -->
                  <% if (booking.status === 'confirmed') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="border-radius: var(--wl-radius-full); font-size: 0.75rem; white-space: nowrap;">Confirmed</span>
                  <% } else { %>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1" style="border-radius: var(--wl-radius-full); font-size: 0.75rem; white-space: nowrap;">Cancelled</span>
                  <% } %>
                </div>
                
                <p class="text-muted mb-2" style="font-size: 0.85rem;">
                  <i class="fa-solid fa-location-dot" style="margin-right: 0.25rem;"></i><%= booking.listing.location %>, <%= booking.listing.country %>
                </p>
                
                <div style="font-size: 0.85rem; color: var(--wl-dark); line-height: 1.5;">
                  <div><strong>Check-in:</strong> <%= booking.startDate.toDateString() %></div>
                  <div><strong>Check-out:</strong> <%= booking.endDate.toDateString() %></div>
                </div>
              </div>

              <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                <div style="font-size: 0.95rem; font-weight: 600;">
                  Total: <span style="color: var(--wl-primary); font-size: 1.1rem;">&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></span>
                </div>
                
                <% if (booking.status === 'confirmed') { %>
                  <!-- Cancel Trip button triggers Bootstrap modal -->
                  <button 
                    type="button" 
                    class="wl-cancel-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#cancelModal-<%= booking._id %>"
                  >
                    <i class="fa-solid fa-ban" style="margin-right: 0.3rem;"></i>Cancel Trip
                  </button>

                  <!-- Cancellation Confirmation Modal -->
                  <div class="modal fade" id="cancelModal-<%= booking._id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content" style="border-radius: var(--wl-radius-lg); border: none; box-shadow: var(--wl-shadow-xl);">
                        <div class="modal-header border-0 pb-0 pt-4 px-4">
                          <h5 class="modal-title" style="font-weight: 700; color: var(--wl-black); font-size: 1.2rem;">
                            <i class="fa-solid fa-triangle-exclamation" style="color: var(--wl-warning); margin-right: 0.4rem;"></i>
                            Cancel Booking
                          </h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body py-3 px-4" style="color: var(--wl-dark); font-size: 0.95rem; line-height: 1.5;">
                          Are you sure you want to cancel your booking for <strong><%= booking.listing.title %></strong>?
                          <br><small style="color: var(--wl-gray); margin-top: 0.5rem; display: block;">This action cannot be undone and will release your reserved dates.</small>
                        </div>
                        <div class="modal-footer border-0 pt-0 pb-4 px-4 gap-2">
                          <button type="button" class="btn-wl-outline px-4" data-bs-dismiss="modal" style="padding: 0.5rem 1.25rem; font-size: 0.85rem;">Go Back</button>
                          <form action="/bookings/<%= booking._id %>/cancel" method="POST" style="margin: 0;">
                            <button type="submit" class="btn-wl-primary px-4" style="padding: 0.5rem 1.25rem; font-size: 0.85rem; background: linear-gradient(135deg, #e31c5f, #c13515);">
                              <i class="fa-solid fa-ban" style="margin-right: 0.3rem;"></i>Confirm Cancel
                            </button>
                          </form>
                        </div>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>
