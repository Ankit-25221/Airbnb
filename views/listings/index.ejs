<% layout("/layouts/boilerplate") %>

<!-- Category Filters -->
<div id="filters">
  <a href="/listings" class="filter <%= activeCategory === '' ? 'active' : '' %>">
    <div><i class="fa-solid fa-border-all"></i></div>
    <p>All</p>
  </a>
  <a href="/listings?category=Trending" class="filter <%= activeCategory === 'Trending' ? 'active' : '' %>">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
  </a>
  <a href="/listings?category=Rooms" class="filter <%= activeCategory === 'Rooms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>
  <a href="/listings?category=Iconic Cities" class="filter <%= activeCategory === 'Iconic Cities' ? 'active' : '' %>">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic Cities</p>
  </a>
  <a href="/listings?category=Mountains" class="filter <%= activeCategory === 'Mountains' ? 'active' : '' %>">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </a>
  <a href="/listings?category=Castles" class="filter <%= activeCategory === 'Castles' ? 'active' : '' %>">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
  </a>
  <a href="/listings?category=Amazing Pools" class="filter <%= activeCategory === 'Amazing Pools' ? 'active' : '' %>">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
  </a>
  <a href="/listings?category=Camping" class="filter <%= activeCategory === 'Camping' ? 'active' : '' %>">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
  </a>
  <a href="/listings?category=Farms" class="filter <%= activeCategory === 'Farms' ? 'active' : '' %>">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
  </a>
  <a href="/listings?category=Arctic" class="filter <%= activeCategory === 'Arctic' ? 'active' : '' %>">
    <div><i class="fa-regular fa-snowflake"></i></div>
    <p>Arctic</p>
  </a>
  <a href="/listings?category=Domes" class="filter <%= activeCategory === 'Domes' ? 'active' : '' %>">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
  </a>
  <a href="/listings?category=Boats" class="filter <%= activeCategory === 'Boats' ? 'active' : '' %>">
    <div><i class="fa-solid fa-ship"></i></div>
    <p>Boats</p>
  </a>

  <!-- Tax Toggle -->
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch mb-0">
      <input 
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="flexSwitchCheckDefault"
      >
      <label class="form-check-label" for="flexSwitchCheckDefault">Taxes</label>
    </div>
  </div>
</div>

<!-- Price Range Filter -->
<div class="wl-price-filter">
  <label for="priceRange"><i class="fa-solid fa-sliders" style="margin-right: 0.3rem;"></i>Max Price</label>
  <input 
    type="range" 
    id="priceRange" 
    class="wl-price-slider" 
    min="0" 
    max="10000" 
    value="10000" 
    step="100"
  >
  <span class="wl-price-value" id="priceValue">&#8377; 10,000+</span>
</div>

<!-- Search results banner -->
<% if (searchQuery) { %>
<div class="wl-search-banner">
  <i class="fa-solid fa-magnifying-glass" style="margin-right: 0.4rem;"></i>
  Showing results for <strong>"<%= searchQuery %>"</strong> — 
  <a href="/listings">Clear search</a>
</div>
<% } %>

<% if (allListings.length === 0) { %>
<div class="wl-no-results">
  <i class="fa-solid fa-magnifying-glass"></i>
  <h4>No listings found</h4>
  <p>Try a different search term or <a href="/listings">view all listings</a>.</p>
</div>
<% } else { %>
<div class="wl-listings-grid" id="listingsGrid">
  <% for (let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="wl-card wl-fade-in" data-price="<%= listing.price %>">
      <div class="wl-card-img-wrap">
        <img 
          src="<%= listing.image.url %>"   
          class="wl-card-img" 
          alt="<%= listing.title %>"
          loading="lazy"
        >
        <% if(listing.category) { %>
          <span class="wl-card-badge"><%= listing.category %></span>
        <% } %>
        <!-- Wishlist heart button overlay -->
        <button 
          class="wl-heart-btn <%= (currUser && userWishlist.some(id => id.toString() === listing._id.toString())) ? 'wishlisted' : '' %>"
          data-listing-id="<%= listing._id %>"
          onclick="event.preventDefault(); toggleWishlist(this);"
          aria-label="Save to wishlist"
        >
          <i class="fa-solid fa-heart"></i>
        </button>
      </div>
      <div class="wl-card-body">
        <div class="wl-card-title"><%= listing.title %></div>
        <div class="wl-card-location">
          <i class="fa-solid fa-location-dot"></i>
          <%= listing.location %>, <%= listing.country %>
        </div>
        <div class="wl-card-price">
          <strong>&#8377; <%= listing.price.toLocaleString("en-IN") %></strong>
          <span>/ night</span>
          <i class="tax-info">&nbsp;+18% GST</i>
        </div>
      </div>
    </a>
  <% } %>
</div>
<% } %>

<script>
  // Tax toggle switch — null guard prevents crash if element is absent
  const taxSwitch = document.getElementById("flexSwitchCheckDefault");
  if (taxSwitch) {
    taxSwitch.addEventListener("click", () => {
      const taxInfo = document.getElementsByClassName("tax-info");
      for (let info of taxInfo) {
        info.style.display = (info.style.display !== "inline") ? "inline" : "none";
      }
    });
  }

  // Price range filter (client-side)
  const priceRange = document.getElementById('priceRange');
  const priceValue = document.getElementById('priceValue');
  const listingsGrid = document.getElementById('listingsGrid');

  if (priceRange && listingsGrid) {
    priceRange.addEventListener('input', () => {
      const maxPrice = parseInt(priceRange.value);
      if (priceValue) {
        priceValue.textContent = maxPrice >= 10000 
          ? '₹ 10,000+' 
          : `₹ ${maxPrice.toLocaleString('en-IN')}`;
      }
      
      const cards = listingsGrid.querySelectorAll('.wl-card');
      cards.forEach(card => {
        const price = parseInt(card.dataset.price || '0');
        card.style.display = (maxPrice >= 10000 || price <= maxPrice) ? '' : 'none';
      });
    });
  }

  // Fade-in on scroll (IntersectionObserver)
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });

    document.querySelectorAll('.wl-fade-in').forEach(el => observer.observe(el));
  } else {
    // Fallback for browsers without IntersectionObserver support
    document.querySelectorAll('.wl-fade-in').forEach(el => el.classList.add('visible'));
  }
</script>